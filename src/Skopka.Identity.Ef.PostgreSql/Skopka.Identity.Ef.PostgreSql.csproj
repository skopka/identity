<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Skopka.Identity.Ef</RootNamespace>
        <Description>PostgreSQL Entity Framework Core provider, stores and packaged migrations for Skopka.Identity.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Skopka.Identity.Ef\Skopka.Identity.Ef.csproj" />
        <ProjectReference Include="..\Skopka.Identity\Skopka.Identity.csproj" />
    </ItemGroup>

</Project>
