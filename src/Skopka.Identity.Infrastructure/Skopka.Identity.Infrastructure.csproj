<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Password hashers, action tokens, OTP, rate limiting and JWT adapters for Skopka.Identity.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.21.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Skopka.Identity.Abstractions\Skopka.Identity.Abstractions.csproj" />
        <ProjectReference Include="..\Skopka.Identity\Skopka.Identity.csproj" />
    </ItemGroup>

</Project>
